# Public site URL used for canonical links, Open Graph, robots, and sitemap.
NEXT_PUBLIC_SITE_URL=https://www.clinic-genie.com

# Supabase (server only — never expose the service role key to the browser)
# Use the project root URL only. Do not append /rest/v1/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Notion CMS (server only — never expose the integration token to the browser)
# Create an internal integration at https://www.notion.so/my-integrations
# Share the Genie Tips Content database with that integration, then paste the values below.
# Source site: https://clinicgenie.notion.site/Genie-Tips-4d1f45ca50148254b8c6011478a1dfc9
# Use the Content collection ID (not the site page ID ending in 4d1f45ca...).
# Expected Content properties: Name (title), Slug (rich_text), Ready to Publish (checkbox),
# Publish Date (date), Excerpt / Meta Description (rich_text), Tags (relation)
NOTION_TOKEN=ntn_your_notion_integration_token
NOTION_DATABASE_ID=your_notion_content_database_id

# Resend email notifications
# Verify clinic-genie.com at resend.com/domains before using hello@ addresses.
# Until the domain is verified, use onboarding@resend.dev as from and the
# Resend account email as CONTACT_NOTIFICATION_EMAIL.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Clinic Genie <hello@clinic-genie.com>
CONTACT_NOTIFICATION_EMAIL=hello@clinic-genie.com
